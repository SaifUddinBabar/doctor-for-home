# Required in production
AUTH_SECRET=replace-with-a-random-secret-before-production
DATABASE_URL="file:./dev.db" # or postgresql://user:password@localhost:5432/doctorsforhome in production
GROQ_API_KEY=
ADMIN_REGISTRATION_KEY=admin-secret-register-key-2026

# Optional: Real Email Delivery via SMTP (e.g., Gmail App Password)
# To get a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# EMAIL_FROM="DoctorForHome <your-email@gmail.com>"

# Optional: Real Email Delivery via Resend
# RESEND_API_KEY="re_..."
