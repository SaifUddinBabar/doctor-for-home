datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  passwordHash         String
  role                 String          @default("Patient") // "Patient" | "Doctor" | "Admin"
  emailVerified        Boolean         @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  phone                String?
  avatar               String?
  otpHash              String?
  otpExpires           DateTime?
  otpAttempts          Int             @default(0)
  otpLastSent          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  patientProfile       PatientProfile?
  doctorProfile        DoctorProfile?
  notifications        Notification[]
  auditLogs            AuditLog[]
}

model PatientProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      String?
  gender           String?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  medicalHistory   String?
  allergies        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  appointments     Appointment[]
  prescriptions    Prescription[]
  medicalReports   MedicalReport[]
  homeVisits       HomeVisit[]
  labTestBookings  LabTestBooking[]
}

model DoctorProfile {
  id                   String         @id @default(uuid())
  userId               String         @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization       String
  qualifications       String?
  bmdcNumber           String         @unique
  experienceYears      Int            @default(0)
  consultationFee      Float          @default(0.0)
  homeVisitFee         Float?
  bio                  String?
  hospitalAffiliation  String?
  location             String?
  avatar               String?
  availableDays        String?         // JSON array of strings e.g. ["Monday","Tuesday","Wednesday","Thursday","Friday"]
  availableTimeSlots   String?         // JSON array of strings e.g. ["09:00","10:00","11:00","14:00","15:00","16:00"]
  slotDurationMinutes  Int             @default(30)
  blockedDates         String?         // JSON array of date strings e.g. ["2026-12-25"]
  verificationStatus   String          @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  verificationNotes    String?
  certificateUrl       String?
  availabilitySchedule String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  appointments         Appointment[]
  prescriptions        Prescription[]
}

model Appointment {
  id              String          @id @default(uuid())
  patientId       String
  patient         PatientProfile  @relation(fields: [patientId], references: [id])
  doctorId        String?
  doctor          DoctorProfile?  @relation(fields: [doctorId], references: [id])
  appointmentType String          // Video Consultation | Home Visit | In-Clinic | Diagnostic Test
  scheduledDate   String
  scheduledTime   String
  status          String          @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED | REJECTED
  patientName     String
  patientPhone    String
  patientEmail    String
  address         String?
  notes           String?
  meetingRoomId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Prescription {
  id           String         @id @default(uuid())
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       DoctorProfile  @relation(fields: [doctorId], references: [id])
  diagnosis    String
  medicines    String         // JSON array string
  advice       String?
  followUpDate String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MedicalReport {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  title     String
  category  String
  fileUrl   String
  fileType  String
  fileSize  Int
  testDate  String?
  notes     String?
  createdAt DateTime       @default(now())
}

model HomeVisit {
  id                 String         @id @default(uuid())
  patientId          String
  patient            PatientProfile @relation(fields: [patientId], references: [id])
  serviceType        String
  address            String
  scheduledDate      String
  scheduledTime      String
  status             String         @default("PENDING") // PENDING | CONFIRMED | ASSIGNED | ON_THE_WAY | COMPLETED | CANCELLED
  assignedStaffName  String?
  assignedStaffPhone String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model LabTestBooking {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id])
  testName             String
  sampleCollectionType String         @default("HOME_COLLECTION")
  address              String
  scheduledDate        String
  scheduledTime        String
  price                Float
  status               String         @default("PENDING") // PENDING | COMPLETED | CANCELLED
  reportUrl            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userId        String
  amount        Float
  currency      String   @default("BDT")
  provider      String   @default("SSLCOMMERZ")
  status        String   @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  purpose       String   // APPOINTMENT | HOME_VISIT | LAB_TEST
  referenceId   String?
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | URGENT
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  targetResource String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())
}
